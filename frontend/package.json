{
  "name": "tams-frontend",
  "version": "1.0.0",
  "description": "TAMS GIS Command Center - Next.js Frontend (Render)",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-cesium.js",
    "dev": "node scripts/copy-cesium.js && next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && node scripts/copy-cesium.js && next dev",
    "build": "node scripts/copy-cesium.js && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/cache": "^11.13.5",
    "@emotion/react": "^11.13.5",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.13.5",
    "@hookform/resolvers": "^3.3.0",
    "@mapbox/mapbox-gl-draw": "^1.4.0",
    "@mui/icons-material": "^5.16.14",
    "@mui/material": "^5.16.14",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@reduxjs/toolkit": "^1.9.0",
    "@tanstack/react-query": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.293.0",
    "mapbox-gl": "^3.0.0",
    "maplibre-gl": "^5.24.0",
    "next": "^14.0.0",
    "postcss": "^8.5.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-redux": "^8.1.0",
    "recharts": "^2.10.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cesium": "^1.142.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "prettier": "^3.1.0",
    "vitest": "^1.0.0"
  }
}
