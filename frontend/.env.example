# Frontend environment template — copy to .env for local dev.
# Never commit real .env files. NEXT_PUBLIC_* is visible in the browser.

# --- Local connection (browser → Next proxy → backend) ---
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_URL=http://127.0.0.1:8000

# --- Render website + Railway API (production) ---
# On Render, set BOTH to your Railway public URL:
#   BACKEND_URL=https://YOUR-SERVICE.up.railway.app
#   NEXT_PUBLIC_HOSTED_API_BASE_URL=https://YOUR-SERVICE.up.railway.app/api/v1
# On Railway, CORS_ORIGINS must include your Render site, e.g.:
#   https://tams-txmr.onrender.com
NEXT_PUBLIC_HOSTED_API_BASE_URL=

# Mapbox / Cesium (optional)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_ID=
NEXT_PUBLIC_IMAGERY_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_CESIUM_ASSET_BASE_URL=/cesium/

NEXT_PUBLIC_APP_NAME=TAMS Platform
NEXT_PUBLIC_APP_VERSION=1.0.0

NEXT_PUBLIC_FEATURE_3D_VISUALIZATION=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_ALERTS=true
NEXT_PUBLIC_FEATURE_PREDICTIONS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
