# Frontend environment template — copy to .env and fill in your values.
# NEXT_PUBLIC_* vars are exposed to the browser.

# API — local dev calls /api/v1 which Next.js proxies to BACKEND_URL.
# In production, set to the full backend URL, e.g. https://your-app.up.railway.app/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_URL=http://localhost:8000

# Mapbox — styled map / "+ Labels" layer
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
NEXT_PUBLIC_MAPBOX_STYLE_ID=mapbox://styles/your-user/your-style-id

# Satellite imagery basemap (Esri World Imagery) for 2D + 3D
NEXT_PUBLIC_IMAGERY_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer

# Cesium Ion token (optional — enables 3D world terrain)
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token

# Cesium JS assets path (auto-copied to public/cesium on install/build)
NEXT_PUBLIC_CESIUM_ASSET_BASE_URL=/cesium/

NEXT_PUBLIC_APP_NAME="TAMS Platform"
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_FEATURE_3D_VISUALIZATION=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_ALERTS=true
NEXT_PUBLIC_FEATURE_PREDICTIONS=false

# Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false
