# Frontend environment template — copy to .env for local / Render

NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional. Unset = infer from the frontend port (:3000→:8000, :3002→:8002)
# BACKEND_URL=http://127.0.0.1:8000
# BACKEND_PORT=8000

# Render production (Railway API — not Postgres):
# BACKEND_URL=https://tams-backend.up.railway.app
# NEXT_PUBLIC_HOSTED_API_BASE_URL=https://tams-backend.up.railway.app/api/v1
NEXT_PUBLIC_HOSTED_API_BASE_URL=

# Optional public site URL (leave empty to use the current origin)
# Render: https://tams-txmr.onrender.com
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_ID=
NEXT_PUBLIC_IMAGERY_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_CESIUM_ASSET_BASE_URL=/cesium/

NEXT_PUBLIC_APP_NAME=TAMS Platform
NEXT_PUBLIC_APP_VERSION=1.0.0

NEXT_PUBLIC_FEATURE_3D_VISUALIZATION=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_ALERTS=true
NEXT_PUBLIC_FEATURE_PREDICTIONS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Auth (JWT httpOnly cookie). Defaults used if unset:
# Username: Admin  Password: Mitcon@2026
# JWT_SECRET=change-me-in-production
# TAMS_AUTH_USERNAME=Admin
# TAMS_AUTH_PASSWORD=Mitcon@2026
